* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Fine riga fissa: i file .bat devono avere CRLF per funzionare su Windows; gli script per Linux/Mac e quelli
# copiati nell'immagine Docker devono avere LF (con CRLF "#!/bin/sh^M" non parte il container).
*.bat text eol=crlf
MAC-Orario-Scuola.app/Contents/MacOS/* text eol=lf
MAC-Orario-Scuola.app/Contents/Info.plist text eol=lf
*.ico binary
*.icns binary
*.png binary
*.sh text eol=lf
docker/** text eol=lf
Dockerfile text eol=lf
compose.yaml text eol=lf
